generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  subject   String
  message   String
  phone     String?
  ip        String?
  ua        String?
}

model Comment {
  id        Int      @id @default(autoincrement())
  movieId   Int
  name      String   @default("Guest")
  body      String
  createdAt DateTime @default(now())

  @@index([movieId])
}

model User {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  password         String?
  image            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  accounts         Account[]
  sessions         Session[]
  watchlist        WatchlistItem[]
  notifications    Notification[]
  continueWatching ContinueWatching[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  tmdbId      Int
  mediaType   String
  title       String
  posterPath  String?
  releaseDate String?
  voteAverage Float?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  tmdbId    Int?
  mediaType String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContinueWatching {
  id         String   @id @default(cuid())
  userId     String
  tmdbId     Int
  mediaType  String
  title      String
  posterPath String?
  progress   Int      @default(0)
  duration   Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
}

model CachedGame {
  rawgId          Int       @id
  slug            String    @unique
  name            String
  released        DateTime?
  backgroundImage String?
  rating          Float     @default(0)
  ratingTop       Int       @default(5)
  ratingsCount    Int       @default(0)
  metacritic      Int?
  playtime        Int       @default(0)

  platformSlugs String[] @default([])
  genreSlugs    String[] @default([])
  tagSlugs      String[] @default([])

  platforms       Json
  parentPlatforms Json?
  genres          Json
  stores          Json?
  screenshots     Json?
  esrbRating      Json?

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([released])
  @@index([rating])
  @@index([metacritic])
  @@index([syncedAt])
}

model CatalogTitle {
  id               String    @id @default(cuid())
  tmdbId           Int
  mediaType        String
  title            String
  originalTitle    String?
  overview         String?
  posterPath       String?
  backdropPath     String?
  releaseDate      DateTime?
  originalLanguage String?
  popularity       Float     @default(0)
  voteAverage      Float     @default(0)
  voteCount        Int       @default(0)
  adult            Boolean   @default(false)
  indexable        Boolean   @default(true)
  syncedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tmdbId, mediaType])
  @@index([mediaType, popularity])
  @@index([mediaType, indexable])
  @@index([releaseDate])
  @@index([syncedAt])
}

model EmailSubscription {
  id                    String    @id @default(cuid())
  email                 String    @unique
  topics                String[]  @default([])
  status                String    @default("pending")
  verificationTokenHash String?   @unique
  verificationExpiresAt DateTime?
  unsubscribeTokenHash  String    @unique
  verifiedAt            DateTime?
  lastSentAt            DateTime?
  consentedAt           DateTime  @default(now())
  consentIp             String?
  consentUserAgent      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([verifiedAt])
  @@index([lastSentAt])
}
